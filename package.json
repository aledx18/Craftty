{
  "name": "craftty",
  "version": "0.1.0",
  "description": "Terminal Minecraft launcher (TUI)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aledx18/Craftty.git"
  },
  "bin": {
    "craftty": "./dist/craftty"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun run src/main.ts",
    "start": "NODE_ENV=production bun run src/main.ts",
    "build": "bun run scripts/build-binary.ts",
    "build:linux-x64": "CRAFTTY_OUT=craftty-linux-x64 CRAFTTY_TARGET=bun-linux-x64 bun run scripts/build-binary.ts",
    "build:linux-arm64": "CRAFTTY_OUT=craftty-linux-arm64 CRAFTTY_TARGET=bun-linux-arm64 bun run scripts/build-binary.ts",
    "build:darwin-arm64": "CRAFTTY_OUT=craftty-darwin-arm64 CRAFTTY_TARGET=bun-darwin-arm64 bun run scripts/build-binary.ts",
    "build:darwin-x64": "CRAFTTY_OUT=craftty-darwin-x64 CRAFTTY_TARGET=bun-darwin-x64 bun run scripts/build-binary.ts",
    "release": "bun run scripts/release.ts",
    "release:dry": "bun run scripts/release.ts --dry-run",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "storage:where": "bun -e \"import { getConfigDirPath } from './src/storage.ts'; console.log(getConfigDirPath())\"",
    "storage:ls": "ls -R ~/.config/craftty* 2>&1 | head -n 50",
    "storage:cat": "echo \"=== DEV (~/.config/craftty-dev) ===\" && cat ~/.config/craftty-dev/*.json 2>/dev/null | head -n 80; echo \"\"; echo \"=== PROD (~/.config/craftty) ===\" && cat ~/.config/craftty/*.json 2>/dev/null | head -n 80",
    "storage:clear": "rm -rf ~/.config/craftty-dev ~/.local/share/craftty-dev && echo \"✓ craftty-dev config + data cleared\"",
    "storage:clear:prod": "rm -rf ~/.config/craftty ~/.local/share/craftty && echo \"✓ craftty config + data cleared\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "cfonts": "^3.3.1",
    "ink": "^7.1.1",
    "react": "^19.2.8"
  }
}
